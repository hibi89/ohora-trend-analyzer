  "pairwise_rules": [
    {
      "terms": "F03.sheer / syrup / jelly",
      "rule": "비슷하지만 다른 시각 표현; 단순 투명성만으로 시럽·젤리 부여 금지. 독립 근거 있으면 공존"
    },
    {
      "terms": "F03.opaque / semi_transparent / transparent",
      "rule": "같은 손톱/부위에서 단계는 배타적. 여러 부위면 scope와 함께 다른 단계 허용"
    },
    {
      "terms": "F06.gradient / ombre",
      "rule": "옴브레는 그라데이션의 하위 표현. 연속 전환 확인 시 공존 가능"
    },
    {
      "terms": "F05.chrome / F04.mirror",
      "rule": "크롬은 효과 F05, 미러는 마감 F04. P0에서 F04는 not_evaluated"
    },
    {
      "terms": "F05.cat_eye / shimmer",
      "rule": "캣아이에는 방향성 빛띠 등 자석 효과 고유 신호 필요"
    },
    {
      "terms": "F05.glitter / shimmer",
      "rule": "입자감 vs 미세한 균일 반짝임 구분"
    },
    {
      "terms": "F09.ribbon / F10.three_d_ribbon",
      "rule": "모양과 볼륨은 다른 축. 높이 근거가 있으면 둘 다"
    },
    {
      "terms": "F09.flower / F10.embossed_flower",
      "rule": "꽃 모티프와 입체 꽃은 별도"
    },
    {
      "terms": "F08.leopard / F09.animal",
      "rule": "반복 동물무늬와 동물 형상을 구분"
    },
    {
      "terms": "F01.gold / F05.metallic",
      "rule": "색상과 효과는 다른 축"
    }
  ],
  "status_contract": {
    "observed": "평가했고 증거에 해당하는 tag_ids 1개 이상",
